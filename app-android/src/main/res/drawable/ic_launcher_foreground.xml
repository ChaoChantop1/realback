<?xml version="1.0" encoding="utf-8"?>
<!--
  RealBack launcher foreground: a white ring with a rising dot —
  "return to the real" (circle = wholeness, dot = you).
  Safe-zone centered 108x108dp adaptive-icon canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring (stroke emulated by two filled circles, even-odd). -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,26 A28,28 0 1,0 54,82 A28,28 0 1,0 54,26 Z M54,32 A22,22 0 1,1 54,76 A22,22 0 1,1 54,32 Z" />

    <!-- Rising dot. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 m-8,0 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0" />
</vector>
