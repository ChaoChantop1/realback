<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage stats access (special permission, granted via Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service keeping usage tracking alive across OEM battery killers -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- RECEIVE_BOOT_COMPLETED was declared here but never used: no receiver is
         registered and no BroadcastReceiver exists, so tracking did not actually
         resume after a reboot. Drop the declaration rather than keep a
         Play-sensitive permission with no behaviour behind it. Re-adding reboot
         persistence means a BOOT_COMPLETED receiver that calls
         UsageTrackingService.start(), plus the permission back. -->

    <!-- M2: intervention reminders -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- M2: battery-optimization whitelist guidance (F-Droid/GitHub distribution;
         revisit for Play Store builds due to policy sensitivity) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RealBackApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RealBack">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Breathing confirmation page, opened via full-screen notification intent -->
        <activity
            android:name=".intervention.BreathingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".service.UsageTrackingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
